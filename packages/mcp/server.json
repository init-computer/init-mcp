{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.init-computer/init",
  "description": "Init is the backend engineer for your coding agent.",
  "repository": {
    "url": "https://github.com/init-computer/init",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "version": "0.1.8",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@init-computer/mcp",
      "version": "0.1.8",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "INIT_API_KEY",
          "description": "Your Init API key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
