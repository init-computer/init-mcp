{
  "name": "init-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "init-monorepo",
      "workspaces": [
        "packages/sdk",
        "packages/cli",
        "packages/mcp"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@init-computer/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@init-computer/mcp": {
      "resolved": "packages/mcp",
      "link": true
    },
    "node_modules/@init-computer/sdk": {
      "resolved": "packages/sdk",
      "link": true
    },
    "packages/cli": {
      "name": "@init-computer/cli",
      "version": "0.1.12",
      "license": "MIT",
      "dependencies": {
        "@init-computer/sdk": "^0.1.11"
      },
      "bin": {
        "init": "bin/init.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/mcp": {
      "name": "@init-computer/mcp",
      "version": "0.1.8",
      "license": "MIT",
      "dependencies": {
        "@init-computer/sdk": "^0.1.11"
      },
      "bin": {
        "init-mcp": "bin/init-mcp.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/sdk": {
      "name": "@init-computer/sdk",
      "version": "0.1.11",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
